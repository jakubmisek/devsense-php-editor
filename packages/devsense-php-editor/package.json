{
  "name": "devsense-php-editor",
  "version": "1.0.0",
  "description": "DEVSENSE PHP editor: server-side PhpEditor (devsense-php-ls over WebSocket) and a browser Monaco editor component",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "bin": {
    "devsense-php-editor": "dist/index.js"
  },
  "scripts": {
    "build": "node build.js",
    "start": "node dist/index.js",
    "prepare": "node build.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "devsense-php-ls": "^1.0.19468",
    "ws": "^8.18.0",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.2",
    "typescript": "^5.8.2",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "DEVSENSE",
  "license": "MIT",
  "keywords": [
    "php",
    "language-server",
    "lsp",
    "devsense",
    "editor",
    "websocket"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/types/providers/browser-index.d.ts",
      "default": "./dist-browser/providers.browser.js"
    }
  },
  "files": [
    "dist",
    "dist-browser",
    "README.md"
  ]
}
