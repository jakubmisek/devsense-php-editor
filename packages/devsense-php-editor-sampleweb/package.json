{
  "name": "devsense-php-editor-sampleweb",
  "version": "1.0.0",
  "private": true,
  "description": "DEVSENSE PHP Editor Playground - sample web application",
  "scripts": {
    "predev": "npm run build --prefix ../devsense-php-editor",
    "dev": "concurrently \"node ../devsense-php-editor/dist/index.js public/php-editor-port\" \"vite --host 0.0.0.0 --port 5173\"",
    "prebuild": "npm run build --prefix ../devsense-php-editor",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.server.json",
    "test": "playwright test",
    "start": "node server/production.js"
  },
  "dependencies": {
    "devsense-php-editor": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "^5.8.2",
    "vite": "^7.3.5",
    "concurrently": "^8.2.2"
  }
}
